APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# SQLite is for local development only; production requires PostgreSQL.
DATABASE_URL=sqlite:///./researchpilot.db
# Set true only for a single-instance development environment. Apply Alembic migrations in production.
RUN_MIGRATIONS_ON_STARTUP=false
RESEARCH_RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TINYFISH_API_KEY=
LLM_API_KEY=
# OpenAI-compatible API base URL, for example https://api.openai.com/v1
LLM_BASE_URL=
LLM_MODEL=

# Optional locally; required for shared production rate limiting.
# Keep credentials in a secret manager; use rediss:// when supported.
REDIS_URL=
