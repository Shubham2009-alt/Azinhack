# Supabase project URL and publishable key (safe for browser use; never use a secret/service-role key here).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional when the frontend and API are deployed on separate origins.
# Leave blank when a same-origin reverse proxy routes /api to the backend.
VITE_API_BASE_URL=
